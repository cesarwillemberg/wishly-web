# URL do FastAPI, sem barra no fim.
# O browser fala só com este Next.js. Os Route Handlers leem o cookie
# httpOnly e chamam o Render com Authorization: Bearer.
API_BASE_URL=https://lista-desejos-backend.onrender.com

# Origem canônica, sem barra no fim. Usada em canonical, Open Graph e no sitemap.
# Se ficar vazia, o padrão é https://wishly-web-sigma.vercel.app.
NEXT_PUBLIC_SITE_URL=https://wishly-web-sigma.vercel.app

# Pixels. Deixe vazio para não carregar o fornecedor.
# Cada um só entra depois do primeiro pointerdown, keydown, scroll ou touchstart.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=
